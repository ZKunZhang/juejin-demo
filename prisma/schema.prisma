generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(32)
  passwordHash String     @map("password_hash")
  displayName  String     @map("display_name") @db.VarChar(80)
  avatarUrl    String?    @map("avatar_url")
  bio          String?
  websiteUrl   String?    @map("website_url")
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  notifications Notification[] @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationActor")
  articles     Article[]
  comments     Comment[]
  reviews      ArticleReview[]
  moderations  CommentModeration[]
  likes        ArticleLike[]
  commentLikes CommentLike[]
  bookmarks    ArticleBookmark[]
  bookmarkCollections BookmarkCollection[]
  following    UserFollow[] @relation("Follower")
  followers    UserFollow[] @relation("Followee")
  activities   Activity[]
  pulses       Pulse[]
  pulseComments PulseComment[]
  pulseCommentLikes PulseCommentLike[]
  pulseReviews PulseReview[]
  pulseCommentReviews PulseCommentReview[]
  courses      Course[]
  courseLessonComments CourseLessonComment[]
  pulseLikes   PulseLike[]
  checkins     Checkin[]
  projects     Project[]
  projectLikes ProjectLike[]
  projectReviews ProjectReview[]
  aiUsageSources AiUsageSource[]
  aiUsagePreference AiUsagePreference?

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  UNLISTED
}

enum ReviewStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model Article {
  id           String        @id @default(uuid()) @db.Uuid
  authorId     String        @map("author_id") @db.Uuid
  title        String        @db.VarChar(160)
  bodyMarkdown String        @map("body_markdown")
  summary      String?
  status       ArticleStatus @default(DRAFT)
  reviewStatus ReviewStatus  @default(NOT_SUBMITTED) @map("review_status")
  viewCount    Int           @default(0) @map("view_count")
  version      Int           @default(1)
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  author       User          @relation(fields: [authorId], references: [id])
  tags         ArticleTag[]
  viewWindows  ArticleViewWindow[]
  comments     Comment[]
  reviews      ArticleReview[]
  likes        ArticleLike[]
  bookmarks    ArticleBookmark[]

  @@index([status, publishedAt, id])
  @@index([authorId, status, updatedAt])
  @@index([reviewStatus, updatedAt, id])
  @@map("articles")
}

enum TagScope {
  BOTH
  ARTICLE
  PULSE
}

model Tag {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique @db.VarChar(64)
  scope     TagScope     @default(BOTH)
  name      String       @db.VarChar(60)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  articles  ArticleTag[]
  pulses    PulseTag[]

  @@map("tags")
}

model ArticleTag {
  articleId String   @map("article_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id])

  @@id([articleId, tagId])
  @@index([tagId, articleId])
  @@map("article_tags")
}

enum ReviewAction {
  SUBMIT
  APPROVE
  REJECT
  UNLIST
  RETURN_TO_DRAFT
  RELIST
}

enum CommentStatus {
  VISIBLE
  HIDDEN
}

model ArticleReview {
  id               String        @id @default(uuid()) @db.Uuid
  articleId        String        @map("article_id") @db.Uuid
  actorId          String        @map("actor_id") @db.Uuid
  articleVersion   Int           @map("article_version")
  action           ReviewAction
  fromStatus       ArticleStatus @map("from_status")
  toStatus         ArticleStatus @map("to_status")
  fromReviewStatus ReviewStatus  @map("from_review_status")
  toReviewStatus   ReviewStatus  @map("to_review_status")
  reason           String?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  article          Article       @relation(fields: [articleId], references: [id])
  actor            User          @relation(fields: [actorId], references: [id])

  @@unique([articleId, articleVersion])
  @@index([articleId, createdAt])
  @@map("article_review_logs")
}

model Comment {
  id          String              @id @default(uuid()) @db.Uuid
  articleId   String              @map("article_id") @db.Uuid
  authorId    String              @map("author_id") @db.Uuid
  parentId    String?             @map("parent_id") @db.Uuid
  body        String
  status      CommentStatus       @default(VISIBLE)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  article     Article             @relation(fields: [articleId], references: [id])
  author      User                @relation(fields: [authorId], references: [id])
  parent      Comment?            @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies     Comment[]           @relation("CommentReplies")
  likes       CommentLike[]
  moderations CommentModeration[]

  @@index([articleId, status, createdAt, id])
  @@index([status, createdAt, id])
  @@index([parentId, status, createdAt, id])
  @@map("comments")
}

model CommentLike {
  userId    String   @map("user_id") @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId, userId])
  @@map("comment_likes")
}

model CommentModeration {
  id         String        @id @default(uuid()) @db.Uuid
  commentId  String        @map("comment_id") @db.Uuid
  adminId    String        @map("admin_id") @db.Uuid
  fromStatus CommentStatus @map("from_status")
  toStatus   CommentStatus @map("to_status")
  reason     String?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  comment    Comment       @relation(fields: [commentId], references: [id])
  admin      User          @relation(fields: [adminId], references: [id])

  @@index([commentId, createdAt])
  @@map("comment_moderation_logs")
}

model ArticleLike {
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId, userId])
  @@map("article_likes")
}

model BookmarkCollection {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks ArticleBookmark[]

  @@unique([userId, id])
  @@unique([userId, name])
  @@map("bookmark_collections")
}

model ArticleBookmark {
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  collectionId String? @map("collection_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  collection BookmarkCollection? @relation(fields: [userId, collectionId], references: [userId, id], onDelete: NoAction)

  @@id([userId, articleId])
  @@index([userId, collectionId, createdAt, articleId], map: "article_bookmarks_user_id_collection_id_created_at_article_id_i")
  @@index([articleId, userId])
  @@map("article_bookmarks")
}

model UserFollow {
  followerId String   @map("follower_id") @db.Uuid
  followeeId String   @map("followee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId, followerId])
  @@map("user_follows")
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  UNLISTED
}

model Activity {
  id          String         @id @default(uuid()) @db.Uuid
  editorId    String         @map("editor_id") @db.Uuid
  title       String         @db.VarChar(120)
  summary     String         @db.VarChar(300)
  url         String?
  coverUrl    String?        @map("cover_url")
  status      ActivityStatus @default(DRAFT)
  sortOrder   Int            @default(0) @map("sort_order")
  visibleFrom DateTime?      @map("visible_from") @db.Timestamptz(3)
  visibleTo   DateTime?      @map("visible_to") @db.Timestamptz(3)
  version     Int            @default(1)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  editor      User           @relation(fields: [editorId], references: [id])

  @@index([status, sortOrder, id])
  @@map("activities")
}


model ArticleViewWindow {
  articleId     String   @map("article_id") @db.Uuid
  viewerKey     String   @map("viewer_key")
  lastCountedAt DateTime @map("last_counted_at") @db.Timestamptz(3)
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, viewerKey])
  @@index([lastCountedAt])
  @@map("article_view_windows")
}

enum PulseStatus {
  PENDING
  PUBLISHED
  REJECTED
  UNLISTED
}

model Pulse {
  id        String      @id @default(uuid()) @db.Uuid
  authorId  String      @map("author_id") @db.Uuid
  body      String
  images    String[]    @default([])
  featured  Boolean     @default(false)
  viewCount Int         @default(0) @map("view_count")
  status    PulseStatus @default(PENDING)
  reviewReason String?  @map("review_reason")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  author    User        @relation(fields: [authorId], references: [id])
  tags      PulseTag[]
  likes     PulseLike[]
  comments  PulseComment[]
  reviews   PulseReview[]
  viewWindows PulseViewWindow[]

  @@index([createdAt, id])
  @@index([status, createdAt, id])
  @@index([authorId, createdAt])
  @@map("pulses")
}

model PulseViewWindow {
  pulseId       String   @map("pulse_id") @db.Uuid
  viewerKey     String   @map("viewer_key")
  lastCountedAt DateTime @map("last_counted_at") @db.Timestamptz(3)
  pulse         Pulse    @relation(fields: [pulseId], references: [id], onDelete: Cascade)

  @@id([pulseId, viewerKey])
  @@index([lastCountedAt])
  @@map("pulse_view_windows")
}

model PulseComment {
  id        String        @id @default(uuid()) @db.Uuid
  pulseId   String        @map("pulse_id") @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  parentId  String?       @map("parent_id") @db.Uuid
  body      String
  status    CommentStatus @default(VISIBLE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  pulse     Pulse         @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id])
  reviews   PulseCommentReview[]
  parent    PulseComment? @relation("PulseCommentReplies", fields:[parentId], references:[id], onDelete:Cascade)
  replies   PulseComment[] @relation("PulseCommentReplies")
  likes     PulseCommentLike[]

  @@index([pulseId, status, createdAt, id])
  @@index([parentId, status, createdAt, id])
  @@index([status, createdAt, id])
  @@map("pulse_comments")
}


model PulseCommentLike {
  userId    String   @map("user_id") @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User @relation(fields:[userId], references:[id], onDelete:Cascade)
  comment   PulseComment @relation(fields:[commentId], references:[id], onDelete:Cascade)

  @@id([userId, commentId])
  @@index([commentId, userId])
  @@map("pulse_comment_likes")
}

model PulseReview {
  id         String      @id @default(uuid()) @db.Uuid
  pulseId    String      @map("pulse_id") @db.Uuid
  adminId    String      @map("admin_id") @db.Uuid
  fromStatus PulseStatus @map("from_status")
  toStatus   PulseStatus @map("to_status")
  reason     String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  pulse      Pulse       @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  admin      User        @relation(fields: [adminId], references: [id])

  @@index([pulseId, createdAt])
  @@map("pulse_reviews")
}

model PulseCommentReview {
  id         String        @id @default(uuid()) @db.Uuid
  commentId  String        @map("comment_id") @db.Uuid
  adminId    String        @map("admin_id") @db.Uuid
  fromStatus CommentStatus @map("from_status")
  toStatus   CommentStatus @map("to_status")
  reason     String?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  comment    PulseComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  admin      User          @relation(fields: [adminId], references: [id])

  @@index([commentId, createdAt])
  @@map("pulse_comment_reviews")
}

model PulseTag {
  pulseId String @map("pulse_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid
  pulse   Pulse  @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id])

  @@id([pulseId, tagId])
  @@index([tagId, pulseId])
  @@map("pulse_tags")
}

model PulseLike {
  userId    String @map("user_id") @db.Uuid
  pulseId   String @map("pulse_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pulse     Pulse  @relation(fields: [pulseId], references: [id], onDelete: Cascade)

  @@id([userId, pulseId])
  @@index([pulseId, userId])
  @@map("pulse_likes")
}

model Checkin {
  userId    String   @map("user_id") @db.Uuid
  localDate DateTime @map("local_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, localDate])
  @@map("checkins")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  UNLISTED
}

enum CourseLevel {
  BEGINNER
  ADVANCED
}

model CourseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(60)
  sortOrder Int      @default(0) @map("sort_order")
  courses   Course[]

  @@map("course_categories")
}

model Course {
  id          String         @id @default(uuid()) @db.Uuid
  categoryId  String         @map("category_id") @db.Uuid
  authorId    String         @map("author_id") @db.Uuid
  title       String         @db.VarChar(160)
  summary     String         @db.VarChar(500)
  description String
  level       CourseLevel
  status      CourseStatus   @default(DRAFT)
  publishedAt DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  category    CourseCategory @relation(fields: [categoryId], references: [id])
  author      User           @relation(fields: [authorId], references: [id])
  lessons     CourseLesson[]

  @@index([status, categoryId, level, publishedAt, id])
  @@map("courses")
}

model CourseLesson {
  id        String       @id @default(uuid()) @db.Uuid
  courseId  String       @map("course_id") @db.Uuid
  position  Int
  title     String       @db.VarChar(160)
  body      String
  status    CourseStatus @default(DRAFT)
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  comments  CourseLessonComment[]

  @@unique([courseId, position])
  @@map("course_lessons")
}


model CourseLessonComment {
  id        String       @id @default(uuid()) @db.Uuid
  lessonId  String       @map("lesson_id") @db.Uuid
  authorId  String       @map("author_id") @db.Uuid
  body      String
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lesson    CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author    User         @relation(fields: [authorId], references: [id])

  @@index([lessonId, createdAt, id])
  @@map("course_lesson_comments")
}

enum NotificationKind {
  ARTICLE_PUBLISHED
  PULSE_PUBLISHED
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  actorId     String           @map("actor_id") @db.Uuid
  kind        NotificationKind
  targetId    String           @map("target_id") @db.Uuid
  preview     String           @db.VarChar(180)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([recipientId, kind, targetId])
  @@index([recipientId, createdAt, id])
  @@index([recipientId, readAt])
  @@index([actorId])
  @@map("notifications")
}

enum ProjectStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  UNLISTED
}

/// 作品广场的作品内容、发布状态及版本。
model Project {
  id            String        @id @default(uuid()) @db.Uuid
  authorId      String        @map("author_id") @db.Uuid
  title         String        @db.VarChar(160)
  summary       String        @db.VarChar(500)
  bodyMarkdown  String        @map("body_markdown")
  coverUrl      String?       @map("cover_url") @db.VarChar(2000)
  projectUrl    String        @map("project_url") @db.VarChar(2000)
  repositoryUrl String?       @map("repository_url") @db.VarChar(2000)
  status        ProjectStatus @default(DRAFT)
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedAt   DateTime?     @map("submitted_at") @db.Timestamptz(3)
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(3)
  author        User          @relation(fields: [authorId], references: [id])
  categoryLinks ProjectCategoryLink[]
  platformLinks ProjectPlatformLink[]
  likes         ProjectLike[]
  viewWindows   ProjectViewWindow[]
  reviews       ProjectReview[]

  @@index([status, publishedAt, id])
  @@index([authorId, updatedAt])
  @@index([status, submittedAt, id])
  @@map("projects")
}

/// 作品分类目录及展示顺序。
model ProjectCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(60)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  projects  ProjectCategoryLink[]

  @@map("project_categories")
}

/// 作品运行平台目录及展示顺序。
model ProjectPlatform {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(60)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  projects  ProjectPlatformLink[]

  @@map("project_platforms")
}

/// 作品与分类的多对多关系。
model ProjectCategoryLink {
  projectId  String          @map("project_id") @db.Uuid
  categoryId String          @map("category_id") @db.Uuid
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   ProjectCategory @relation(fields: [categoryId], references: [id])

  @@id([projectId, categoryId])
  @@index([categoryId, projectId])
  @@map("project_category_links")
}

/// 作品与运行平台的多对多关系。
model ProjectPlatformLink {
  projectId  String          @map("project_id") @db.Uuid
  platformId String          @map("platform_id") @db.Uuid
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform   ProjectPlatform @relation(fields: [platformId], references: [id])

  @@id([projectId, platformId])
  @@index([platformId, projectId])
  @@map("project_platform_links")
}

/// 用户对作品的点赞关系。
model ProjectLike {
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId, createdAt, projectId])
  @@map("project_likes")
}

/// 同一作品、访问者和统计窗口内只保留一条浏览记录。
model ProjectViewWindow {
  projectId   String   @map("project_id") @db.Uuid
  viewerKey   String   @map("viewer_key") @db.VarChar(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, viewerKey, windowStart])
  @@index([windowStart])
  @@map("project_view_windows")
}

/// 作品审核操作及状态变更日志。
model ProjectReview {
  id             String        @id @default(uuid()) @db.Uuid
  projectId      String        @map("project_id") @db.Uuid
  actorId        String        @map("actor_id") @db.Uuid
  version        Int
  action         String        @db.VarChar(32)
  previousStatus ProjectStatus @map("previous_status")
  nextStatus     ProjectStatus @map("next_status")
  reason         String?       @db.VarChar(1000)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor          User          @relation(fields: [actorId], references: [id])

  @@unique([projectId, version])
  @@index([actorId, createdAt])
  @@map("project_reviews")
}

model AiProvider {
  id     String    @id @default(uuid()) @db.Uuid
  slug   String    @unique @db.VarChar(64)
  name   String    @db.VarChar(120)
  models AiModel[]

  @@map("ai_providers")
}

/// 各供应商提供的模型目录及启用状态。
model AiModel {
  id         String         @id @default(uuid()) @db.Uuid
  providerId String         @map("provider_id") @db.Uuid
  modelKey   String         @map("model_key") @db.VarChar(160)
  name       String         @db.VarChar(160)
  active     Boolean        @default(true)
  provider   AiProvider     @relation(fields: [providerId], references: [id])
  prices     AiModelPrice[]
  events     AiUsageEvent[]

  @@unique([providerId, modelKey])
  @@map("ai_models")
}

/// 产生 AI 用量的客户端和开发工具目录。
model AiTool {
  id      String          @id @default(uuid()) @db.Uuid
  slug    String          @unique @db.VarChar(64)
  name    String          @db.VarChar(120)
  sources AiUsageSource[]

  @@map("ai_tools")
}

/// 按模型、币种和生效区间维护的历史计价记录。
model AiModelPrice {
  id              String         @id @default(uuid()) @db.Uuid
  modelId         String         @map("model_id") @db.Uuid
  currency        String         @db.VarChar(3)
  effectiveFrom   DateTime       @map("effective_from") @db.Timestamptz(3)
  effectiveTo     DateTime?      @map("effective_to") @db.Timestamptz(3)
  inputPrice      Decimal        @map("input_price") @db.Decimal(20, 8)
  outputPrice     Decimal        @map("output_price") @db.Decimal(20, 8)
  cacheReadPrice  Decimal?       @map("cache_read_price") @db.Decimal(20, 8)
  cacheWritePrice Decimal?       @map("cache_write_price") @db.Decimal(20, 8)
  sourceUrl       String         @map("source_url") @db.VarChar(2000)
  observedAt      DateTime       @map("observed_at") @db.Timestamptz(3)
  model           AiModel        @relation(fields: [modelId], references: [id])
  events          AiUsageEvent[]

  @@index([modelId, currency, effectiveFrom])
  @@map("ai_model_prices")
}

/// 用户授权的用量导入来源及其撤销状态。
model AiUsageSource {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  toolId    String         @map("tool_id") @db.Uuid
  label     String         @db.VarChar(120)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime?      @map("revoked_at") @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      AiTool         @relation(fields: [toolId], references: [id])
  events    AiUsageEvent[]

  @@index([userId, createdAt, id])
  @@index([toolId])
  @@map("ai_usage_sources")
}

/// 按来源幂等登记的 Token 用量与费用估算记录。
model AiUsageEvent {
  id                      String        @id @default(uuid()) @db.Uuid
  sourceId                String        @map("source_id") @db.Uuid
  sourceEventKey          String        @map("source_event_key") @db.VarChar(160)
  modelId                 String        @map("model_id") @db.Uuid
  occurredAt              DateTime      @map("occurred_at") @db.Timestamptz(3)
  inputTokens             BigInt        @map("input_tokens")
  unclassifiedInputTokens BigInt        @map("unclassified_input_tokens")
  outputTokens            BigInt        @map("output_tokens")
  cacheReadTokens         BigInt        @map("cache_read_tokens")
  cacheWriteTokens        BigInt        @map("cache_write_tokens")
  priceId                 String?       @map("price_id") @db.Uuid
  estimatedCostUsd        Decimal?      @map("estimated_cost_usd") @db.Decimal(24, 10)
  source                  AiUsageSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  model                   AiModel       @relation(fields: [modelId], references: [id])
  price                   AiModelPrice? @relation(fields: [priceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, sourceEventKey])
  @@index([sourceId, occurredAt, id])
  @@index([modelId, occurredAt])
  @@index([priceId])
  @@map("ai_usage_events")
}

/// 用户的 AI 用量公开偏好，默认不公开排行。
model AiUsagePreference {
  userId            String   @id @map("user_id") @db.Uuid
  publicLeaderboard Boolean  @default(false) @map("public_leaderboard")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_usage_preferences")
}

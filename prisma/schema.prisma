generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(32)
  passwordHash String     @map("password_hash")
  displayName  String     @map("display_name") @db.VarChar(80)
  avatarUrl    String?    @map("avatar_url")
  bio          String?
  websiteUrl   String?    @map("website_url")
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  articles     Article[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  UNLISTED
}

enum ReviewStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model Article {
  id           String        @id @default(uuid()) @db.Uuid
  authorId     String        @map("author_id") @db.Uuid
  title        String        @db.VarChar(160)
  bodyMarkdown String        @map("body_markdown")
  summary      String?
  status       ArticleStatus @default(DRAFT)
  reviewStatus ReviewStatus  @default(NOT_SUBMITTED) @map("review_status")
  version      Int           @default(1)
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  author       User          @relation(fields: [authorId], references: [id])
  tags         ArticleTag[]

  @@index([status, publishedAt, id])
  @@index([authorId, status, updatedAt])
  @@index([reviewStatus, updatedAt, id])
  @@map("articles")
}

model Tag {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique @db.VarChar(64)
  name      String       @db.VarChar(60)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  articles  ArticleTag[]

  @@map("tags")
}

model ArticleTag {
  articleId String   @map("article_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id])

  @@id([articleId, tagId])
  @@index([tagId, articleId])
  @@map("article_tags")
}
